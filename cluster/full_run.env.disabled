# Full-run config, FINAL 2026-08-03. Chosen from measured 1,500-step sweep arms
# ranked on the full 2,039-fact PolyFact-Clean test and 17-language KLAR.
#
#   --max_grad_norm 5.0  : the single dominant knob. Qwen KLAR -1.20 (clip1) ->
#     +8.67 (clip5), matching CM-Align's +8.85; OLMo -4.58 -> +1.34. Confirmed
#     on BOTH families. clip20 is worse (+7.36), so ~5 is near the optimum.
#   --learning_rate 1e-5 : every measurement above was produced at 1e-5. Not
#     raised to 2e-5 for the 4x batch because the full run already has 6.7x the
#     validated arm's updates (10,000 vs 1,500), so undertraining is not a risk,
#     and stacking an untested change is exactly what failed below.
#   all_or_nothing bonus : the graded ladder reaches +8.17 KLAR ALONE, but
#     ladder+clip5 = +7.06, BELOW both single interventions (~5 SE on KLAR,
#     n=44,949) and worst of any arm on PolyFact TotCons (+1.42). They INTERFERE.
#     Ladder stays implemented and unused.
#   --kl_coef 0.0        : k3-estimator sweep showed KL hurts at clip5
#     (ffTotCons 0.193 -> 0.153) and is worst at 0.05.
#
# Net: ZERO untested variables. The only delta from the validated arms is GPU
# count, which changes facts-per-step, not the optimisation.
EXTRA="--max_grad_norm 5.0"
TAG_SUFFIX="-clip5"

# OLMo runs ~9.88 s/step vs Qwen's 8.17, so 10,000 steps needs 27.4h and would be
# killed at ~83% of the cosine inside a 23h limit. Size it to finish instead:
# same facts-per-step and same peak LR, but the schedule COMPLETES (anneal to 0
# and a proper final save) rather than being cut mid-decay.
# NOTE: this must live here, not in --export, because this file is sourced AFTER
# the script reads EXTRA from the environment and would otherwise clobber it.
if [[ "${MTAG:-qwen}" == "olmo" ]]; then
  EXTRA="$EXTRA --max_train_samples 32000"
fi
